  "luci-app-rmm-dashboard": {
    "description": "Read router and RMM agent status",
    "read": {
      "ubus": {
        "system": [ "board", "info" ],
        "network.interface": [ "dump" ],
        "network.device": [ "status" ],
        "service": [ "list" ]
      },
      "uci": [ "rmm-agent" ]
    }
  }
}